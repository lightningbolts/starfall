{
  "name": "starfall",
  "private": true,
  "version": "0.1.0",
  "description": "Starfall — graph-based space territory conquest",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @starfall/sim test && pnpm --filter @starfall/macro-sim test && pnpm --filter @starfall/server test",
    "sim:ffa": "pnpm --filter @starfall/cli start",
    "server": "pnpm --filter @starfall/server exec tsx src/index.ts",
    "web": "pnpm --filter @starfall/web exec vite",
    "dev": "sh -c 'pnpm run server -- --players 8 --bots 7 & spid=$!; trap \"kill $spid 2>/dev/null\" EXIT INT TERM; pnpm run web'",
    "smoke": "pnpm --filter @starfall/server smoke",
    "load": "pnpm --filter @starfall/server load",
    "typecheck": "pnpm -r run typecheck"
  }
}
